{
    "version": 2,
    "builds": [
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/main.py"
        }
    ],
    "env": {
        "WHATSAPP_ACCESS_TOKEN": "@whatsapp_access_token",
        "WHATSAPP_PHONE_NUMBER_ID": "@whatsapp_phone_number_id",
        "VERIFY_TOKEN": "@verify_token",
        "GEMINI_API_KEY": "@gemini_api_key",
        "MONGODB_URI": "@mongodb_uri"
    }
}