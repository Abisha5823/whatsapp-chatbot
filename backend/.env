# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ID=your_business_id
VERIFY_TOKEN=your_custom_verify_token

# AI Provider (Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo
USE_GEMINI=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=whatsapp_chatbot
MONGODB_COLLECTION_CONVERSATIONS=conversations
MONGODB_COLLECTION_LEADS=leads
MONGODB_COLLECTION_BOOKINGS=bookings

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS=path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# Email Notifications
OWNER_EMAIL=owner@business.com
OWNER_PHONE=+919876543210
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_SENDER=your_email@gmail.com

# Business Configuration
BUSINESS_NAME=Solar Solutions Tamil Nadu
ASSISTANT_NAME=Solar Assistant
BUSINESS_SCHEDULE=Mon-Sat 9AM-6PM
SERVICES="Solar Installation, Battery Systems, Inverters, Maintenance"

# General
PORT=8000
DEBUG=false